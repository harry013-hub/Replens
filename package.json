{
  "name": "replens",
  "version": "1.0.0",
  "private": true,
  "description": "Camera-based push-up and squat counter that runs in the browser.",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "python3 tests/e2e/browser_test.py",
    "vendor": "node scripts/vendor.mjs",
    "test:mealbase": "cd mealbase && npm test",
    "test:browser:mealbase": "python3 tests/e2e/mealbase_tab_test.py",
    "build:mealbase": "cd mealbase && npm install && npm run build:replens"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "1.1.1"
  },
  "engines": {
    "node": ">=18"
  }
}
