# MealBase configuration. Copy to `.env` and edit. Never commit `.env`.
# Everything here is read by the SERVER only; nothing below is sent to the browser
# except the non-secret values noted as "public".

# ── Server ───────────────────────────────────────────────────────────────
PORT=3000
# 127.0.0.1 = only this computer. Use 0.0.0.0 in a container / on a host (requires AUTH_MODE=accounts).
HOST=127.0.0.1
NODE_ENV=development

# SQLite database file (created automatically).
DATABASE_PATH=./data/mealbase.sqlite

# Where the API and UI are mounted (public). Change when combining with another site.
API_BASE_PATH=/api/v1/nutrition
APP_BASE_PATH=/

# ── Authentication ───────────────────────────────────────────────────────
# local    = single-user demo, no sign-in. Everyone who can reach the server shares ONE food log.
# accounts = email + password sign-in, each user sees only their own data. Use for any shared deployment.
AUTH_MODE=local
# Only if you really run local mode on a private network interface:
# ALLOW_PUBLIC_SINGLE_USER=false
SESSION_TTL_HOURS=336
# Defaults to true when NODE_ENV=production. Requires HTTPS.
# SECURE_COOKIES=true

# ── Food database: USDA FoodData Central ── API KEY REQUIRED for live search ──
# Free key: https://fdc.nal.usda.gov/api-key-signup  (a data.gov key)
# DEMO_KEY works for a quick try but is limited to 30 requests/hour and 50/day per IP.
# Default limit for a real key: 1,000 requests/hour per IP.
# Without a key, food search shows only your own and sample foods; manual entry always works.
USDA_API_KEY=
# USDA_API_BASE_URL=https://api.nal.usda.gov/fdc/v1

# Show bundled development sample foods in search (clearly labelled). Default: on in development, off in production.
# SAMPLE_FOODS_ENABLED=true
# Load sample foods + starter recipes into an empty database on start.
AUTO_SEED=true

# ── Workout app connection (optional) ────────────────────────────────────
# Public URL of the workout app. When empty, Today shows "Workout connection not configured".
WORKOUT_APP_URL=
WORKOUT_APP_LABEL=Workouts

# Server-to-server API access for a separately deployed workout app (SECRET).
# Calls must send:  Authorization: Bearer <token>   and   X-MealBase-User: <workout app user id>
INTEGRATION_SERVICE_TOKEN=

# Signed webhooks for nutrition events (SECRET). Leave empty to disable.
INTEGRATION_WEBHOOK_URL=
INTEGRATION_WEBHOOK_SECRET=

# Serve a built UI from a custom folder (normally automatic).
# STATIC_DIR=./dist/public
